# ------------------------------------------------------------------
# VoxAI configuration example.
# If `.env` does not exist, copy this template and adjust the values as needed.
# PowerShell: if (-not (Test-Path .env)) { Copy-Item .env.example .env }
# Sensible defaults are provided; GEMINI_API_KEY is required for chat.
# ------------------------------------------------------------------

# ---- LLM (Google Gemini) -------------------------------------------
# Get a key from https://aistudio.google.com/app/apikey.
# Keep this value private; it is only read by the Flask backend.
GEMINI_API_KEY=
# Optional PREFERRED model. VoxAI queries the API key at runtime for the models
# it can actually use (models.list), keeps the ones that support text
# generation (generateContent), and automatically picks the best available
# one -- stable Gemini Flash models first. The value below is only used when
# discovery finds it; otherwise the best discovered model is selected.
# Leave it EMPTY to disable the preference and always auto-select.
GEMINI_MODEL=gemini-2.5-flash
# Bounded retries: rejected models (unavailable/unsupported OR quota-limited)
# and transient overload answers (5xx "high demand") each try at most this
# many candidates (small bound: 1-10; never retries indefinitely).
# A 429 quota-limited model is skipped within this bound (Google per-model
# free-tier limits reset on their own schedule); quota is reported as 429
# only when it blocks every allowed try. 401/403 (auth) stop immediately.
GEMINI_MODEL_ATTEMPTS=3
# Seconds to wait for one Gemini API request before returning a 504.
GEMINI_TIMEOUT_S=60
# Sampling temperature for the assistant.
LLM_TEMPERATURE=0.6
# Hard cap on the number of tokens the LLM may generate.
MAX_RESPONSE_TOKENS=200
# Hidden reasoning tokens Gemini may spend before answering. 0 (default)
# disables reasoning for fast short spoken answers; -1 keeps provider default.
GEMINI_THINKING_BUDGET=0
# How many *turns* (user+assistant pairs) of history are sent to the model.
MAX_HISTORY_TURNS=8

# ---- STT (faster-whisper) ------------------------------------------
# Model size: tiny, base, small, medium, large-v3 ...
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional: pin the language instead of auto-detecting ("" = auto).
WHISPER_LANGUAGE=
# Where downloaded whisper weights are cached.
WHISPER_DOWNLOAD_ROOT=./models/whisper
# Decoding width: 1 = greedy (fastest, default), 2-10 = beam search (slower,
# marginally better on noisy audio). Greedy is ~2x faster on CPU.
WHISPER_BEAM_SIZE=1

# ---- TTS (Piper) ---------------------------------------------------
# English voice model (downloaded by scripts/prefetch_assets.py).
PIPER_MODEL_PATH=./models/voices/en_US-ryan-medium.onnx
# Hindi voice, used automatically when the detected language is Hindi.
# en_US-ryan and hi_IN-rohan are both MALE single-speaker voices, so the
# speaker gender stays consistent across English and Hindi.
# If this file is missing, Hindi answers keep their text but speech fails
# with a clear error instead of silently switching to the English voice.
PIPER_MODEL_PATH_HI=./models/voices/hi_IN-rohan-medium.onnx
# Voice speed: lower = slower (0.6) ... higher = faster (2.0).
PIPER_LENGTH_SCALE=1.0

# ---- Sessions / limits ---------------------------------------------
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=500
MAX_MESSAGE_CHARS=2000
MAX_AUDIO_BYTES=15728640
AUDIO_TTL_SECONDS=1800
# Directory that holds generated WAV files served by /api/audio/
AUDIO_DIR=./var/audio

# ---- Web Search (optional live web retrieval) -----------------------
# Set to 1 to enable search for questions requiring current facts (0 to disable).
WEB_SEARCH_ENABLED=1
# Search provider: duckduckgo (free, no API key required).
WEB_SEARCH_PROVIDER=duckduckgo
# Search request timeout in seconds.
WEB_SEARCH_TIMEOUT_S=8.0
# Maximum search result snippets passed to the LLM context (1-10).
WEB_SEARCH_MAX_RESULTS=3

# ---- Runtime behaviour ----------------------------------------------
# Set to 1 to abort startup when a required model file is missing
# (default: start anyway and report the problem through /api/health
#  and actionable 503s on the affected endpoints).
STRICT_STARTUP=0
# Set to 1 to run pytest with real services (integration tests).
RUN_INTEGRATION=0
